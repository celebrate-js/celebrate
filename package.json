{
  "name": "@celebrate-js/celebrate",
  "version": "0.1.0",
  "type": "module",
  "description": "React向けの「決まった瞬間」の演出ライブラリ（印影スタンプ・紙吹雪・花火・ボーダーエフェクトなど）。",
  "license": "MIT",
  "author": "sato mikoto",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sato0825/celebrate-js.git"
  },
  "homepage": "https://github.com/sato0825/celebrate-js#readme",
  "bugs": {
    "url": "https://github.com/sato0825/celebrate-js/issues"
  },
  "keywords": [
    "react",
    "confetti",
    "celebration",
    "animation",
    "ui-feedback",
    "particles"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./celebrate.css": "./src/celebrate.css"
  },
  "files": [
    "dist",
    "src/celebrate.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^2.1.4"
  }
}
